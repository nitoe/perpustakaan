// ============================================================================
// ATURAN PERPUSTAKAAN — untuk DITEMPEL ke firestore.rules di repo SDM01Penilaian
// (satu project Firebase hanya punya satu berkas rules; repo perpustakaan TIDAK
// men-deploy rules supaya aturan Penilaian dan Sarpras tidak tertimpa).
//
// Bagian A: tempel fungsi-fungsi ini di dalam `match /databases/{database}/documents`,
//           tepat setelah fungsi-fungsi Sarpras (`sarprasStaf()`).
// Bagian B: tempel blok `match` ini tepat SEBELUM blok "Default: tolak semuanya".
// Bagian C: UBAH blok `match /siswa/{id}` yang sudah ada (dua baris saja).
// Sesudah itu: uji, lalu `npm run deploy:rules` di repo SDM01Penilaian.
//
// Cara memberi akses: di Firestore, dokumen users/{uid} cukup diberi field teks
// `peranPerpus` = "pustakawan" | "pimpinan" | "guru". Admin Penilaian otomatis admin
// perpustakaan; semua jenis guru otomatis "guru". Tanpa membuat akun baru.
// ============================================================================


// ───────────────────────── BAGIAN A: fungsi ─────────────────────────

    // ---- Perpustakaan: peran -------------------------------------------------
    // Sumber peran: admin Penilaian = admin perpustakaan. Selain itu field
    // users/{uid}.peranPerpus ('admin' | 'pustakawan' | 'pimpinan' | 'guru'), yang hanya bisa
    // diubah admin (aturan `users` melarang pemilik akun mengubahnya). Bila kosong, semua
    // jenis guru dianggap 'guru'. Peran lain tanpa peranPerpus = tidak punya akses.
    // Memakai .get('role', '') (bukan myRole()) supaya akun tanpa field `role`, mis. petugas TU
    // yang hanya diberi peranPerpus, tidak membuat aturan error.
    // Harus sama dengan peranDari() di src/lib/peran.ts repo perpustakaan.
    // Kelak untuk akun siswa: tambahkan peran 'siswa' di sini dan di peran.ts.
    function peranPerpus() {
      return myProfile().get('role', '') == 'admin' ? 'admin'
        : myProfile().get('peranPerpus',
            myProfile().get('role', '') in ['guru', 'guru_tahsin_tahfizh', 'guru_akademik'] ? 'guru' : '');
    }

    function perpusAdmin() {
      return akunAktif() && peranPerpus() == 'admin';
    }

    // Admin dan pustakawan: mengelola koleksi dan mencatat sirkulasi.
    function perpusPustakawan() {
      return akunAktif() && peranPerpus() in ['admin', 'pustakawan'];
    }

    function perpusStaf() {
      return akunAktif() && peranPerpus() in ['admin', 'pustakawan', 'pimpinan', 'guru'];
    }

    function perpusBukuSah(d) {
      return d.judul is string && d.judul.size() > 0 && d.judul.size() <= 300
        && d.jenis in ['cetak', 'digital', 'keduanya'];
    }

    // Status eksemplar sebelum dan sesudah permintaan (batch) dijalankan.
    function perpusEksemplarSebelum(kode) {
      return get(/databases/$(database)/documents/perpus_eksemplar/$(kode)).data;
    }
    function perpusEksemplarSesudah(kode) {
      return getAfter(/databases/$(database)/documents/perpus_eksemplar/$(kode)).data;
    }


// ───────────────────────── BAGIAN B: blok match ─────────────────────────

    // ---- Perpustakaan (koleksi berawalan perpus_) ----------------------------

    // Kategori: semua staf membaca, admin dan pustakawan mengelola.
    match /perpus_kategori/{id} {
      allow read: if perpusStaf();
      allow create, update: if perpusPustakawan();
      allow delete: if perpusAdmin();
    }

    // Katalog buku. Staf membaca; buku bertanda `publik` boleh dibaca siapa saja (katalog publik).
    // Kueri publik WAJIB: where('publik','==',true). Bawaan: tidak publik.
    match /perpus_buku/{id} {
      allow read: if perpusStaf() || resource.data.get('publik', false) == true;
      allow create, update: if perpusPustakawan() && perpusBukuSah(request.resource.data);
      allow delete: if perpusAdmin();
    }

    // Eksemplar: ID dokumen = kode di label (mis. PRP-000123). Status berubah lewat sirkulasi.
    match /perpus_eksemplar/{id} {
      allow read: if perpusStaf();
      allow create: if perpusPustakawan()
                    && request.resource.data.status == 'tersedia'
                    && request.resource.data.bukuId is string;
      allow update: if perpusPustakawan()
                    && request.resource.data.bukuId == resource.data.bukuId
                    && request.resource.data.status in ['tersedia', 'dipinjam', 'hilang', 'dihapus'];
      allow delete: if perpusAdmin();
    }

    // Anggota non-siswa (guru, karyawan, kelas). Siswa dikenali dari koleksi `siswa`.
    match /perpus_anggota/{id} {
      allow read: if perpusStaf();
      allow create, update: if perpusPustakawan();
      allow delete: if perpusAdmin();
    }

    // Peminjaman: hanya admin/pustakawan. Pinjam/kembali wajib batch dengan status eksemplar.
    match /perpus_peminjaman/{id} {
      allow read: if perpusStaf();
      allow create: if perpusPustakawan()
                    && request.resource.data.status == 'dipinjam'
                    && request.resource.data.petugasUid == request.auth.uid
                    && request.resource.data.peminjam.tipe in ['siswa', 'anggota']
                    && perpusEksemplarSebelum(request.resource.data.eksemplarId).status == 'tersedia'
                    && perpusEksemplarSesudah(request.resource.data.eksemplarId).status == 'dipinjam';
      allow update: if perpusPustakawan()
                    && resource.data.status == 'dipinjam'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'tglKembali', 'jatuhTempo', 'jumlahPerpanjang',
                                   'kondisiKembali', 'catatan', 'updatedAt'])
                    && request.resource.data.status in ['dipinjam', 'dikembalikan']
                    && (request.resource.data.status == 'dipinjam'
                        || perpusEksemplarSesudah(resource.data.eksemplarId).status in ['tersedia', 'hilang']);
      allow delete: if false;
    }

    // Kunjungan: dicatat pustakawan; tidak bisa diubah.
    match /perpus_kunjungan/{id} {
      allow read: if perpusStaf();
      allow create: if perpusPustakawan()
                    && request.resource.data.keys().hasAll(['tanggal', 'pengunjung']);
      allow update: if false;
      allow delete: if perpusAdmin();
    }

    // Sampul buku terkompres (string base64).
    // Baca: staf ATAU siapa saja (agar katalog publik bisa menampilkan sampul).
    // Isi hanya JPEG kecil; tidak ada data sensitif.
    match /perpus_foto/{id} {
      allow read: if true;
      allow create: if perpusPustakawan()
                    && request.resource.data.keys().hasOnly(['data', 'createdBy', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.data is string
                    && request.resource.data.data.size() <= 120000;
      allow update: if false;
      allow delete: if perpusAdmin();
    }

    // Pengaturan (dokumen `aturan`): staf membaca, admin mengubah.
    // Dokumen `penomoran`: pustakawan boleh MENAIKKAN `terakhir` saja.
    match /perpus_config/{id} {
      allow read: if perpusStaf();
      allow write: if perpusAdmin();
      allow create, update: if perpusPustakawan() && id == 'penomoran'
                            && request.resource.data.keys().hasOnly(['terakhir', 'updatedAt'])
                            && request.resource.data.terakhir is int
                            && request.resource.data.terakhir >= 0
                            && (request.method == 'create'
                                || request.resource.data.terakhir >= resource.data.terakhir);
    }

    // Log perubahan: staf menulis atas namanya, hanya admin membaca, tidak bisa diubah.
    match /perpus_log/{id} {
      allow read: if perpusAdmin();
      allow create: if perpusStaf() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Koleksi fase 2 lanjutan (perpus_usulan, perpus_reservasi) dan fase 3 (perpus_jurnal):
    // belum ada aturan = ditolak default.


// ───────────────────────── BAGIAN C: ubah blok `siswa` ─────────────────────────
//   allow get: if isGuru() || perpusPustakawan() || anakSaya(id);
//   allow list: if isGuru() || perpusPustakawan();
